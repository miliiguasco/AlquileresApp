@using AlquileresApp.Core.Entidades
@using AlquileresApp.Core.CasosDeUso.Propiedad
@using AlquileresApp.Core.CasosDeUso.Reserva
@using AlquileresApp.Core.Interfaces
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JSRuntime
@inject CasoDeUsoListarPropiedades CUListarPropiedades
@inject CasoDeUsoEliminarPropiedad CUEliminarPropiedad
@inject CasoDeUsoModificarPropiedad CUModificarPropiedad

@inject CasoDeUsoCancelarReserva CUCancelarReserva
@inject CasoDeUsoMarcarPropiedadComoNoHabitable CUMarcarPropiedadComoNoHabitable
@inject ILogger<Propiedades> Logger
@inject NavigationManager NavigationManager
@inject INotificadorEmail NotificadorEmail
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="admin-section">

    @if (propiedades != null && propiedades.Any())
    {
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success">@mensajeExito</div>
    }
    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger">@mensajeError</div>
    }
        <div class="table-container">
            <table class="property-table">  
                <thead>
                    <tr>
                        <th>Imagen</th>
                        <th>Título</th>
                        <th>Ubicación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prop in propiedades)
                    {
                        <tr>
                            <td class="image-cell">
                                @{
                                    var imagenUrl = "/Imagenes/Propiedades/iconoimagen.jpg";
                                    if (prop.Imagenes != null && prop.Imagenes.Any())
                                    {
                                        var primeraImagen = prop.Imagenes.FirstOrDefault();
                                        if (primeraImagen != null && !string.IsNullOrEmpty(primeraImagen.Url))
                                        {
                                            imagenUrl = primeraImagen.Url.StartsWith("/") ? 
                                                primeraImagen.Url : 
                                                $"/Imagenes/Propiedades/{primeraImagen.Url}";
                                        }
                                    }
                                }
                                <img src="@imagenUrl" alt="@prop.Titulo" />
                            </td>
                            <td>@prop.Titulo</td>
                            <td>@prop.Localidad</td>
                            <td class="actions-cell">
                                <div class="actions-wrapper">
                                    <button class="btn btn-primary" title="Editar" @onclick="() => EditarPropiedad(prop)"
                                            disabled="@EsPropiedadBorrada(prop)">
                                        <i class="fas fa-edit"></i>
                                    </button>


                                    @if (isAdmin)
                                    {
                                        @if (!EsPropiedadBorrada(prop)) 
                                        {
                                            <button class="btn btn-danger" title="Eliminar" @onclick="() => EliminarPropiedad(prop)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success" title="Activar" @onclick="() => ActivarPropiedad(prop)">
                                                <i class="fas fa-check-circle"></i>
                                            </button>
                                        }
                                        <button title="@(prop.Destacada ? "Destacar" : "Desmarcar")" style="background-color: @(prop.Destacada ? "#ffc107" : "gray"); color: white"
                                            class="@GetClaseBotonDestacar(prop)"
                                            @onclick="() => DestacarPropiedad(prop)"
                                            disabled="@(prop.NoHabitable || EsPropiedadBorrada(prop))">
                                            <i class="@GetIconoBotonDestacar(prop)"></i>
                                        </button>
                                    }

                                    @if (isEncargado)
                                    {
                                        <button title="@(prop.NoHabitable ? "Habilitar" : "Inhabilitar")" style="background-color: @(prop.NoHabitable ? "green" : "#dc3545"); color: white" class="btn btn-warning" @onclick="() => IniciarCambioEstadoHabitabilidad(prop)"
                                                disabled="@EsPropiedadBorrada(prop)">
                                            @if (prop.NoHabitable)
                                            {
                                                <i class="fas fa-check-circle"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-ban"></i>
                                            }
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        <button class="btn-naranja btn-agregar" @onclick="() => NuevaPropiedad()">
            Nueva propiedad
        </button>
        </div>
    }
    else
    {
        <p>No hay propiedades disponibles.</p>
    }
</div>
@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Cancelación</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CancelarConfirmacion"></button>
                </div>
                <div class="modal-body">
                    <p>¿Estás seguro de que querés eliminar esta propiedad?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn-naranja" @onclick="CancelarConfirmacion">No</button>
                    <button class="btn-naranja" @onclick="@(async () => await ConfirmarCancelacion())">Sí, eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Aquí se renderiza el componente modal de Reubicación de Reserva *@
@if (mostrarModalReubicacion)
{
    <ReubicacionReserva
        IsVisible="mostrarModalReubicacion"
        ReservaAfectada="reservaActualParaModal"
        AlternativasDisponibles="alternativasActualesParaModal"
        OnPropiedadSeleccionada="HandlePropiedadSeleccionada"
        OnCerrarModal="HandleCerrarModal" 
        OnConfirmarInhabilitacionSinReubicacion="HandleConfirmarInhabilitacionSinReubicacion" /> 
}

@code {
    private List<Propiedad>? propiedades;
    private bool cargando = true;



    private Propiedad propiedadAEliminar;
    private string mensajeError;
    private string mensajeExito;
    private bool mostrarConfirmacion = false;

    private bool mostrarModalReubicacion = false;
    private Reserva reservaActualParaModal;
    private List<Propiedad> alternativasActualesParaModal;
    private Propiedad propiedadQueSeEstaEvaluando;

    private List<KeyValuePair<Reserva, List<Propiedad>>>? reservasPendientesDeReubicacion; // Nueva variable para controlar el flujo
    private int indiceReservaActual = 0; 

    [Parameter]
    public bool isEncargado { get; set; }

    [Parameter]
    public bool isAdmin { get; set; }

    protected override async Task OnInitializedAsync()

    {
        try
        {
            
            propiedades = CUListarPropiedades.Ejecutar();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private async Task EditarPropiedad(Propiedad propiedad)
    {
        NavigationManager.NavigateTo($"/EditarPropiedad/{propiedad.Id}");
    }

    private void IniciarCambioEstadoHabitabilidad(Propiedad propiedad)
    {
        try
        {
            propiedadQueSeEstaEvaluando = propiedad; // Se asigna la propiedad que inició el proceso

            Dictionary<Reserva, List<Propiedad>> opcionesDeReubicacion = CUMarcarPropiedadComoNoHabitable.IdentificarReservasYAlternativas(propiedadQueSeEstaEvaluando);

            if (opcionesDeReubicacion.Any())
            {
                reservasPendientesDeReubicacion = opcionesDeReubicacion.ToList();
                indiceReservaActual = 0; // Siempre empezar desde la primera reserva

                PrepararYMostrarModalParaSiguienteReserva();
            }
            else
            {
                // Si no hay reservas que reubicar, se invierte el estado de habitabilidad directamente.
                // Y se actualiza la propiedad en la base de datos.
                propiedadQueSeEstaEvaluando.NoHabitable = !propiedadQueSeEstaEvaluando.NoHabitable;
                CUMarcarPropiedadComoNoHabitable.ActualizarEstadoNoHabitable(propiedadQueSeEstaEvaluando);
                propiedades = CUListarPropiedades.Ejecutar(); // Refrescar la lista

                mensajeError = string.Empty;
                mensajeExito = "El estado de la propiedad se ha actualizado correctamente (no había reservas que reubicar).";
            }

            // Esta lógica para quitar el destacado SOLO se aplica si la propiedad TERMINA en NoHabitable
            if (propiedadQueSeEstaEvaluando.NoHabitable)
            {
                propiedadQueSeEstaEvaluando.Destacada = false;
                CUModificarPropiedad.Ejecutar(propiedadQueSeEstaEvaluando);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al marcar la propiedad como no habitable o procesar sus reservas.");
            mensajeError = $"Error al marcar la propiedad como no habitable: {ex.Message}";
            mensajeExito = string.Empty;
            mostrarModalReubicacion = false;
            propiedades = CUListarPropiedades.Ejecutar(); // Refrescar en caso de error
        }
        StateHasChanged();
    }

    private void PrepararYMostrarModalParaSiguienteReserva()
    {
        if (reservasPendientesDeReubicacion != null && indiceReservaActual < reservasPendientesDeReubicacion.Count)
        {
            // Todavía hay reservas por procesar, mostrar el modal
            var currentEntry = reservasPendientesDeReubicacion[indiceReservaActual];
            reservaActualParaModal = currentEntry.Key;
            alternativasActualesParaModal = currentEntry.Value;

            mostrarModalReubicacion = true;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
        }
        else
        {
            mostrarModalReubicacion = false; 
            // Todas las reservas han sido procesadas. Ahora sí, se invierte el estado final
            // de habitabilidad de la propiedad original y se guarda en la base de datos.
            if (propiedadQueSeEstaEvaluando != null)
            {
                propiedadQueSeEstaEvaluando.NoHabitable = !propiedadQueSeEstaEvaluando.NoHabitable;
                CUMarcarPropiedadComoNoHabitable.ActualizarEstadoNoHabitable(propiedadQueSeEstaEvaluando);

                // Si la propiedad termina como NoHabitable, se le quita el destacado
                if (propiedadQueSeEstaEvaluando.NoHabitable)
                {
                    propiedadQueSeEstaEvaluando.Destacada = false;
                    CUModificarPropiedad.Ejecutar(propiedadQueSeEstaEvaluando);
                }
            }

            mensajeError = string.Empty;
            mensajeExito = "Se han procesado todas las reservas. El estado de la propiedad se ha actualizado correctamente.";
            propiedades = CUListarPropiedades.Ejecutar(); // Refrescar la lista principal de propiedades
        }
        StateHasChanged(); // Forzar el renderizado para mostrar/ocultar el modal o actualizar mensajes
    }

    private async Task HandlePropiedadSeleccionada(Propiedad propiedadSeleccionada)
    {
        try
        {
            // Reasignar la reserva
            if (reservaActualParaModal != null)
            {
                CUMarcarPropiedadComoNoHabitable.ReasignarReserva(reservaActualParaModal, propiedadSeleccionada);

                NotificadorEmail.EnviarCorreoModificacionReservaPorNoHabitable(
                    reservaActualParaModal.Cliente?.Email ?? "",
                    reservaActualParaModal.Cliente?.Nombre ?? "",
                    propiedadQueSeEstaEvaluando?.Titulo ?? "", // Usar propiedadQueSeEstaEvaluando
                    propiedadSeleccionada.Titulo
                );

                mensajeExito = $"Reubicación exitosa de la reserva del cliente '{reservaActualParaModal.Cliente?.Nombre}' a '{propiedadSeleccionada.Titulo}'.";
            }
            mensajeError = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Error al reasignar la reserva {reservaActualParaModal?.Id}.");
            mensajeError = $"Error al reasignar la reserva: {ex.Message}";
            mensajeExito = string.Empty;
        }
        finally
        {
            indiceReservaActual++; // Avanzamos a la siguiente reserva
            PrepararYMostrarModalParaSiguienteReserva(); // Prepara y muestra el siguiente modal o finaliza
        }
    }

    private async Task HandleCerrarModal()
    {
        // El usuario canceló la reubicación para la reserva actual.
        // La política es que la reserva original permanece sin reasignar.
        mensajeError = "La reubicación de la reserva fue cancelada por el usuario. La reserva original permanece sin reasignar.";
        mensajeExito = string.Empty;

        indiceReservaActual++; // Avanzamos a la siguiente reserva sin reubicar la actual
        PrepararYMostrarModalParaSiguienteReserva(); // Prepara y muestra el siguiente modal o finaliza
    }

    private async Task HandleConfirmarInhabilitacionSinReubicacion()
    {
        try
        {
            if (reservaActualParaModal != null)
            {
                // Se cancela la reserva actual
                var resultadoCancelacion = CUCancelarReserva.EjecutarParaInhabitabilidad(reservaActualParaModal.Id);

                NotificadorEmail.EnviarCorreoModificacionReservaPorNoHabitable(
                    reservaActualParaModal.Cliente?.Email ?? "",
                    reservaActualParaModal.Cliente?.Nombre ?? "",
                    propiedadQueSeEstaEvaluando?.Titulo ?? "", // Usar propiedadQueSeEstaEvaluando
                    null // No hay propiedad de reubicación porque se canceló
                );

                mensajeExito = $"La reserva para el cliente '{reservaActualParaModal.Cliente?.Nombre}' en la propiedad '{propiedadQueSeEstaEvaluando?.Titulo}' ha sido cancelada exitosamente.";
            }
            else
            {
                mensajeExito = $"La propiedad '{propiedadQueSeEstaEvaluando?.Titulo}' ha sido marcada como no habitable (no había reservas o la actual no se encontró).";
            }
            mensajeError = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Error al confirmar inhabilitación sin reubicación para la reserva {reservaActualParaModal?.Id}.");
            mensajeError = $"Error al confirmar la inhabilitación sin reubicación: {ex.Message}";
            mensajeExito = string.Empty;
        }
        finally
        {
            indiceReservaActual++; // Avanzamos a la siguiente reserva
            PrepararYMostrarModalParaSiguienteReserva(); // Prepara y muestra el siguiente modal o finaliza
        }
    }

   
    private bool EsPropiedadBorrada(Propiedad prop)
    {
        return prop.Borrada;
    }

    private void EliminarPropiedad(Propiedad propiedad)
    {
        propiedadAEliminar = propiedad;
        mostrarConfirmacion = true;
        mensajeError = null;
        mensajeExito = null;
    }
    private async Task ActivarPropiedad(Propiedad propiedad)
    {
        try
        {
            propiedad.Borrada = false; // Marcamos la propiedad como NO borrada
            CUModificarPropiedad.Ejecutar(propiedad); // Persistimos el cambio
            mensajeExito = $"La propiedad '{propiedad.Titulo}' ha sido activada correctamente.";
            mensajeError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al activar la propiedad.");
            mensajeError = $"Error al activar la propiedad: {ex.Message}";
            mensajeExito = null;
        }
        finally
        {
           propiedades = CUListarPropiedades.Ejecutar();
        }
    }
    private async Task ConfirmarCancelacion()
    {
        try
        {   
            if (CUEliminarPropiedad.Ejecutar(propiedadAEliminar)){
                mensajeExito = $" Propiedad eliminada: {propiedadAEliminar.Titulo}.";
            }
            else
            {
                mensajeError = $"Error al eliminar la propiedad: {propiedadAEliminar.Titulo}. Tiene reservas hechas";
            }
            propiedades = CUListarPropiedades.Ejecutar();
            }
            catch (Exception ex)
            {
            // Manejar el error silenciosamente o mostrar una notificación al usuario si es necesario
        }
        finally
        {   
            mostrarConfirmacion = false;
        }
    }
   private string GetClaseBotonDestacar(Propiedad propiedad)
{
    return propiedad.Destacada ? "btn btn-success" : "btn btn-outline-secondary";
}

private string GetIconoBotonDestacar(Propiedad propiedad)
{
    return propiedad.Destacada ? "fas fa-star" : "far fa-star";
}

private async Task DestacarPropiedad(Propiedad propiedad)
{
    propiedad.Destacada = !propiedad.Destacada;

    CUModificarPropiedad.Ejecutar(propiedad);

    propiedades = CUListarPropiedades.Ejecutar();
}
    private void CancelarConfirmacion()
    {
        mostrarConfirmacion = false;
    }

    private void NuevaPropiedad() {

        NavigationManager.NavigateTo("/PublicarPropiedad");
    }

} 
        